def parzysta(x):
    return x % 2 == 0

#zadanie3
def suma_kwadratow(x):
    return sum(i**2 for i in range(x))


#zadanie4
def czy_pierwsza(x):
    if x < 2:
        return False
    for i in range(2, int(x**0.5) + 1):
        if x % i == 0:
            return False
    return True

#zadanie5
def dzielniki(x):
    return [i for i in range(1, x + 1) if x % i == 0]

#zadanie6
def czynniki_pierwsze(x):
    czynniki = []
    i = 2
    while i * i <= x:
        if x % i:
            i += 1
        else:
            x //= i
            czynniki.append(i)
    if x > 1:
        czynniki.append(x)
    return czynniki

#zadanie7
def najmniejsza_wspolna_wielokrotnosc(x, y):
    return abs(x * y) // math.gcd(x, y)

#zadanie8
def postac_binarna(x):
    return bin(x)[2:]   

#zadanie9
def miejsce_zerowe(x, y, z):
    if x == 0:
        if y != 0:
            return -z / y
        else:
            return None
    delta = y**2 - 4*x*z
    if delta > 0:
        v1 = (-y - math.sqrt(delta)) / (2*x)
        v2 = (-y + math.sqrt(delta)) / (2*x)
        return (v1, v2)
    elif delta == 0:
        v0 = -y / (2*x)
        return (v0,)
    else:
        return None

#zadanie10.1
def silnia(x):
    return math.factorial(x)

#zadanie10.2
def silnia_pentla(x):
    if x == 0:
        return 1
    z = 1
    for i in range (1, x + 1):
        z *= i
    return z
#zadanie10.3
def silnia_rekurencja(x):
    if x == 0:
        return 1
    else:
        return x * silnia_rekurencja(x - 1)

#zadanie11
def ciag_fibonacciego(n):
    x, y = 0, 1
    for _ in range(n):
        x, y = y, x + y
    return x

#zadanie12
def skumulowane_sumy(*args):
    return list(accumulate(args))

#zadanie13
def srednia_arytmetyczna(*args):
    if len(args) > 0:
        suma = sum(args)
        ilosc = len(args)
        return suma / ilosc
    else:
        return 0

#zadanie14
def odwroc_string(s):
    return s[::-1]

#zadanie15
def znicz_male_duze(s):
    male = sum(1 for c in s if c.islower())
    duze = sum(1 for c in s if c.isupper())
    return male, duze

#zadanie16
def unikalne_znaki(tab):
    x = []
    for z in tab:
        if z not in x:
            x.append(z)
    return x

#zadanie17
def czestosc_wystepowania_znakow(s):
    z = {}
    for x in s:
        if x in z:
            z[x] += 1
        else:
            z[x] = 1
    return z

#zadanie18
def podziel_string_na_slowa(s):
    slowa = []
    aktualne_slowo = ""

    for znak in s:
        if znak != " ":
            aktualne_slowo += znak
        else:
            if aktualne_slowo != "":
                slowa.append(aktualne_slowo)
                aktualne_slowo = ""
    if aktualne_slowo != "":
        slowa.append(aktualne_slowo)
    return slowa


#zadanie19
def camel_case(s):
    slowa = s.split()
    if len(slowa) == 0:
        return ""
    wynik = slowa[0].lower()

    for i in range(1, len(slowa)):
        kolejne_slowo = slowa[i]
        wynik += slowa[i].capitalize()
    return wynik

#zadanie20
def return_camelcase(s):
    wynik = ""
    for i in s:
        if i.isupper():
            wynik += " "
            wynik += i.lower()
        else:
            wynik += i
    return wynik.strip()

#zadanie21
def pierwiastek_babilonski(s):
    if s < 0:
        return 0
    x = s / 2.0
    dok = 0.0000000001

    while True:
        y = (x + s / x) / 2.0
        roz = abs(y - x)
        if roz < dok:
            return y

        x = y

#zadanie22
def pi_carlo(n):
    b =0

    for _ in range(n):
        x = random.random()
        y = random.random()
        if (x*x) + (y*y) <= 1:
            b += 1
    pi = 4 * b / n
    return pi

#zadanie23
def zrob_pary(x, y):
    pary = []
    z = len(x)

    for i in range(z):
        nowa_para = (x[i], y[i])
        pary.append(nowa_para)
    return pary

def dzielne_przez_3_nie_5():
    z = []
    for i in range(100):
        if i % 3 == 0:
            if i % 5 != 0:
                z.append(i)
    return z


